{
  "name": "padova-operating-system",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "partnerships:demo:setup": "tsx scripts/partnerships/demo.ts setup",
    "partnerships:demo": "tsx scripts/partnerships/demo.ts start",
    "partnerships:migration": "tsx scripts/partnerships/prepare-migration.ts",
    "partnerships:test": "tsx --test --test-concurrency=1 tests/partnerships.test.ts tests/partnerships-security.test.ts",
    "partnerships:test:http": "tsx scripts/partnerships/test-http.ts",
    "partnerships:prepare": "tsx scripts/partnerships/build-package.ts",
    "partnerships:verify": "tsx scripts/partnerships/verify-package.ts",
    "partnerships:mail:prepare": "tsx scripts/partnerships/prepare-mail-refresh.ts",
    "partnerships:import": "tsx scripts/partnerships/import-package-http.ts",
    "qa:setup": "node scripts/qa.mjs setup",
    "qa:build": "node scripts/qa.mjs build",
    "qa:start": "node scripts/share-qa.mjs",
    "qa:test": "node scripts/qa.mjs test",
    "owner:provision": "node --use-system-ca --env-file-if-exists=.env.local --import tsx scripts/provision-owner.ts",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "backup:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-backup.ts",
    "backup:system": "node --use-system-ca --env-file-if-exists=.env.local --import tsx scripts/capture-recovery.ts",
    "backup:restore-test": "node --use-system-ca --env-file-if-exists=.env.local --import tsx scripts/restore-recovery-test.ts",
    "staff:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-staff.ts",
    "format": "prettier --write src scripts tests db docs README.md AGENTS.md package.json tsconfig.json next.config.ts",
    "format:check": "prettier --check src scripts tests docs README.md AGENTS.md package.json tsconfig.json next.config.ts",
    "test:http": "tsx scripts/test-http.ts",
    "test:auth": "tsx --test tests/authentication.test.ts",
    "test:hosted": "node --use-system-ca --env-file-if-exists=.env.local --import tsx scripts/test-hosted.ts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-database.ts",
    "adapter:prepare": "tsx scripts/prepare-padova.ts",
    "test:padova": "tsx --test --test-concurrency=1 tests/padova.test.ts tests/supabase-auth.test.ts",
    "test:padova:financial": "node scripts/test-padova-financial.mjs",
    "db:inspect": "node --use-system-ca --import tsx scripts/inspect-existing-connection.ts",
    "test:hosted:financial": "node --use-system-ca --env-file-if-exists=.env.local --import tsx scripts/test-hosted-financial.ts",
    "intake:whatsapp-bridge": "node scripts/whatsapp-pc-bridge.mjs",
    "intake:whatsapp-web": "node scripts/whatsapp-web-reader.mjs",
    "intake:whatsapp-helper": "node scripts/whatsapp-web-reader.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@napi-rs/canvas": "^0.1.65",
    "@vercel/functions": "3.10.6",
    "@whiskeysockets/baileys": "^6.7.18",
    "lucide-react": "0.548.0",
    "next": "16.4.3",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "8.16.3",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^5.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
